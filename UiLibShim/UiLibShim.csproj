<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compatibility shim for the "augaassets" bundle.

    The Auga prefabs were built when Valheim shipped its UI widgets in ui_lib.dll under the Fishlabs namespace.
    Valheim 1.x moved them to gui_framework.dll (namespace GUIFramework), so every prefab input field resolves to
    "missing script (Fishlabs.GuiInputField)". Until the bundle is rebuilt against gui_framework.dll, this
    assembly (named ui_lib, like the original) provides Fishlabs.GuiInputField as a subclass of the real widget.
    Auga embeds it and loads it before the bundle (see Auga.LoadDependencies), which is enough for Unity to
    resolve the MonoScript references.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ui_lib</AssemblyName>
    <RootNamespace>Fishlabs</RootNamespace>
    <LangVersion>10</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <!-- Auga.csproj embeds bin\<Configuration>\ui_lib.dll, so the path must not depend on the framework. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the game and Unity references JotunnLib's props wire up. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

</Project>
