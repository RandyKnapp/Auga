# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
*/[Ll]ibrary/
*/[Tt]emp/
*/[Oo]bj/
*/[Bb]uild/
*/[Bb]uilds/
*/[Ll]ogs/
*/[Mm]emoryCaptures/
*/bin/
*/obj/

# Built assembly
AugaUnity/Assets/ExternalLibraries/Unity.Auga.dll

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

.idea

# Local build references from the old setup-references.ps1 (publicized game assemblies, APIManager.dll). Nothing
# uses them any more: JotunnLib publicizes into the game folder, and APIManager is compiled from source.
References/

# Machine-local build overrides (see Environment.props.example)
Environment.props

# Filled with the built plugin while mod-tools packages a release
*/Package/plugins/*

# mod-tools credentials
.env

# build output of nested tool projects (the */bin/ rule above only matches one level deep)
**/[Bb]in/
**/[Oo]bj/

# Visual Studio project conversion reports
UpgradeLog*.htm

# Local Claude Code instructions, kept out of the repository
CLAUDE.md
