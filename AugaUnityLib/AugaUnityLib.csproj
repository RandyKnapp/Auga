<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity.Auga.dll: the MonoBehaviour widgets used by the Auga prefabs. It is compiled here (against the game
    assemblies), copied into the Unity project (AugaUnity\Assets\ExternalLibraries) so the prefabs can reference
    the scripts, and embedded into Auga.dll which loads it at runtime.
    The game, Unity and BepInEx references come from the JotunnLib package, with the paths resolved in
    ..\Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Unity.Auga</AssemblyName>
    <RootNamespace>AugaUnity</RootNamespace>
    <LangVersion>10</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Auga.csproj embeds bin\<Configuration>\Unity.Auga.dll, so the path must not depend on the framework. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);UNITY_5_6_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the game, Unity and BepInEx references JotunnLib's props wire up. Nothing here uses a Jotunn
         type, so Jotunn.dll is neither referenced at runtime nor copied. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- An older copy of the Coffee.UIEffects scripts that has never been part of the build: the Unity project
         carries the package itself, and only UIGradient\ is compiled here. -->
    <Compile Remove="UIDissolve.cs;UIEffect.cs;UIFlip.cs;UIGradient.cs;UIHsvModifier.cs" />
    <None Include="UIDissolve.cs;UIEffect.cs;UIFlip.cs;UIGradient.cs;UIHsvModifier.cs" />
  </ItemGroup>

  <!-- Compile-only: the game and BepInEx assemblies are already loaded at runtime. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <!-- Keep the copy inside the Unity project in sync so the prefabs keep their script references. -->
  <Target Name="CopyToUnityProject" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\AugaUnity\Assets\ExternalLibraries')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\AugaUnity\Assets\ExternalLibraries\" />
  </Target>

</Project>
