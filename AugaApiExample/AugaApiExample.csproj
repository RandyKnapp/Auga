<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Example mod that consumes the Auga API the way a third-party mod would: it compiles the API stub into its own
    assembly (the same API.cs and API.Common.cs the AugaAPI project builds, with the API constant defined) and
    soft-depends on Auga, so APIManager redirects the stub's calls to the real Auga.dll when Auga is installed.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AugaApiExample</AssemblyName>
    <RootNamespace>AugaApiExample</RootNamespace>
    <LangVersion>10</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Selects the stub branch of every method in API.cs. -->
    <DefineConstants>$(DefineConstants);API</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the game, Unity and BepInEx references JotunnLib's props wire up. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Compile Include="..\Auga\API\API.cs" Link="AugaAPI\API.cs" />
    <Compile Include="..\Auga\API\API.Common.cs" Link="AugaAPI\API.Common.cs" />
  </ItemGroup>

</Project>
