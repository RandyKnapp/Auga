<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Auga</RootNamespace>
    <AssemblyName>Auga</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Makes the compiler emit the SkipVerification request for the publicized game assemblies
         (see ..\Build\IgnoresAccessChecksTo.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" />
    <!-- Taken as a Thunderstore dependency (ValheimModding-JsonDotNET, see Package/manifest.json), not shipped. A
         second copy of Newtonsoft.Json.dll beside another mod's is an assembly identity conflict under Mono. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- API\API.cs and API.Common.cs are also compiled by ..\AugaAPI, with the API constant defined, into the stub
       other mods reference. -->
  <ItemGroup>
    <!-- The old reflection-and-transpiler API wrapper older mods copied into their own code, kept for reference.
         It does not compile as written. -->
    <Compile Remove="API\API.External.cs" />
    <None Include="API\API.External.cs" />
    <!-- An InventoryGrid.UpdateGui rewrite from a 0.217 PTB attempt that has been out of the build since then. -->
    <Compile Remove="Modules\Inventory\InventoryGrid_Patches.cs" />
    <None Include="Modules\Inventory\InventoryGrid_Patches.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj" />
    <!-- ui_lib.dll shim (Fishlabs.GuiInputField) for the prefabs; only embedded, never referenced. -->
    <ProjectReference Include="..\UiLibShim\UiLibShim.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Resources loaded at runtime from the manifest as "Auga.<file>" (see Auga.LoadDependencies, LoadAssetBundle and
       LoadTranslations). A loose file of the same name in BepInEx\plugins\Auga\ or next to Auga.dll wins over the
       embedded bundle and translations (Auga.GetAssetPath). -->
  <ItemGroup>
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets" Link="Assets\augaassets" LogicalName="$(RootNamespace).augaassets" />
    <EmbeddedResource Include="Assets\translations.json" LogicalName="$(RootNamespace).translations.json" />
    <EmbeddedResource Include="..\AugaUnityLib\bin\$(Configuration)\Unity.Auga.dll" Link="Assets\Unity.Auga.dll" LogicalName="$(RootNamespace).Unity.Auga.dll" />
    <EmbeddedResource Include="..\UiLibShim\bin\$(Configuration)\ui_lib.dll" Link="Assets\ui_lib.dll" LogicalName="$(RootNamespace).ui_lib.dll" />
  </ItemGroup>

  <!-- BEGIN mod-tools (managed block; replaced by `mod-tools setup`) -->
  <PropertyGroup>
    <RepoRoot Condition=" '$(RepoRoot)' == '' ">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</RepoRoot>
    <!-- Override in the gitignored Environment.props when the gem's bindir
         is not on the PATH that MSBuild sees. -->
    <ModTools Condition=" '$(ModTools)' == '' ">mod-tools</ModTools>
  </PropertyGroup>

  <!-- Nothing is vendored into this repo, so a machine that never installed
       the tools has no mod-tools at all. This probes for it once and warns,
       rather than failing: not having a release tool should not stop anyone
       compiling. Everything below is then conditioned on the result, so a
       machine without it skips those steps instead of failing three times
       over with "command not found" buried in Exec output. -->
  <Target Name="ModToolsGuard" BeforeTargets="Build">
    <Exec Command="$(ModTools) preflight --root &quot;$(RepoRoot).&quot;" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ModToolsExit" />
    </Exec>
    <PropertyGroup>
      <ModToolsAvailable Condition=" '$(ModToolsExit)' == '0' ">true</ModToolsAvailable>
    </PropertyGroup>
    <Warning Condition=" '$(ModToolsAvailable)' != 'true' " Text="mod-tools is not installed on this machine, or this repo is not set up. Skipping release checks, packaging and deploy. Install it with `rake install` from a clone of the tools repo; see its SETUP.md." />
  </Target>

  <!-- After the build, not before it. `check` packages as well as checks
       now, and packaging reads the assembly the compile just produced, so
       a BeforeTargets hook would stage the previous one. The cost is that
       a bad version story is reported after the compile rather than
       instead of it; the build still fails, one step later. -->
  <Target Name="ReleaseChecks" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) check --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <!-- No Configuration condition, unlike the one above: every build lands
       in the test profiles, Debug and Release alike. Declared last so it
       runs after a GenerateMdb target defined earlier in this file, whose
       .mdb it copies. Does nothing unless release.yml enables deploy. -->
  <Target Name="ModToolsDeploy" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' ">
    <Exec Command="$(ModTools) deploy --root &quot;$(RepoRoot).&quot; --configuration $(Configuration)" />
  </Target>
  <!-- END mod-tools -->
</Project>
