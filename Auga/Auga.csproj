<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework (netstandard2.1), LangVersion and the Valheim/BepInEx paths come from ..\Directory.Build.props -->
  <PropertyGroup>
    <AssemblyName>Auga</AssemblyName>
    <RootNamespace>Auga</RootNamespace>
    <Configurations>Debug;Release;API</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsApiBuild>false</IsApiBuild>
    <IsApiBuild Condition="'$(Configuration)' == 'API'">true</IsApiBuild>
  </PropertyGroup>

  <!-- 'API' builds only the public API surface (API.cs / API.Common.cs) into AugaAPI.dll for other mods to reference. -->
  <PropertyGroup Condition="'$(IsApiBuild)' == 'true'">
    <AssemblyName>AugaAPI</AssemblyName>
    <OutputPath>bin\API\</OutputPath>
    <DefineConstants>$(DefineConstants);API;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- APIManager is merged into Auga.dll by ILRepack (see ILRepack.targets), so it must be copied to the output folder. -->
    <Reference Include="APIManager">
      <HintPath>$(AugaRefs)\APIManager\APIManager.dll</HintPath>
    </Reference>
    <Reference Include="fastJSON">
      <HintPath>..\Libs\fastJSON.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim_publicized">
      <HintPath>$(ValheimRefs)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils_publicized">
      <HintPath>$(ValheimRefs)\assembly_guiutils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils_publicized">
      <HintPath>$(ValheimRefs)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework_publicized">
      <HintPath>$(ValheimRefs)\gui_framework_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Compiled in every configuration (the API surface). -->
  <ItemGroup>
    <Compile Include="API.cs" />
    <Compile Include="API.Common.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- The mod itself. -->
  <ItemGroup Condition="'$(IsApiBuild)' != 'true'">
    <Compile Include="Auga.cs" />
    <Compile Include="MovableHudElement.cs" />
    <Compile Include="AugaLog_Hooks.cs" />
    <Compile Include="Chat_Setup.cs" />
    <Compile Include="Connection_Setup.cs" />
    <Compile Include="DamageText_Setup.cs" />
    <Compile Include="Extensions.cs" />
    <Compile Include="GuiBar_Patch.cs" />
    <Compile Include="Hud_Setup.cs" />
    <Compile Include="KeyHints_Patch.cs" />
    <Compile Include="KeyHints_Setup.cs" />
    <Compile Include="Settings_Builder.cs" />
    <Compile Include="LastHitTracker.cs" />
    <Compile Include="MainMenu_Setup.cs" />
    <Compile Include="MainMenu_Extras.cs" />
    <Compile Include="MainMenu_StartGame.cs" />
    <Compile Include="PanelRestyle.cs" />
    <Compile Include="MessageHud_Setup.cs" />
    <Compile Include="PauseMenu_Setup.cs" />
    <Compile Include="PlayerInventory_Setup.cs" />
    <Compile Include="Settings_Setup.cs" />
    <Compile Include="SetupHelper.cs" />
    <Compile Include="Store_Setup.cs" />
    <Compile Include="TextInput_Setup.cs" />
    <Compile Include="EnemeyHud_Setup.cs" />
    <Compile Include="TextViewer_Setup.cs" />
    <Compile Include="Text_Patch.cs" />
    <Compile Include="UITooltip_Patch.cs" />
    <Compile Include="Minimap_Setup.cs" />
    <Compile Include="Barber_Setup.cs" />
    <Compile Include="Compat\Chatter.cs" />
    <Compile Include="Compat\Jewelcrafting.cs" />
    <Compile Include="Compat\SearsCatalog.cs" />
    <Compile Include="SkillsDialog_Patch.cs" />
    <Compile Include="Utilities\TranspilerHelpers.cs" />
    <Compile Include="Utilities\SerializedFieldHelper.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsApiBuild)' != 'true'">
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj" />
    <!-- ui_lib.dll shim (Fishlabs.GuiInputField) for the prefabs; only embedded, never referenced. -->
    <ProjectReference Include="..\UiLibShim\UiLibShim.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Resources loaded at runtime from the manifest as "<AssemblyName>.<file>" (see Auga.LoadDependencies / LoadAssets). -->
  <ItemGroup Condition="'$(IsApiBuild)' != 'true'">
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets" Link="augaassets" LogicalName="$(RootNamespace).augaassets" />
    <EmbeddedResource Include="..\AugaUnityLib\bin\$(Configuration)\Unity.Auga.dll" Link="Unity.Auga.dll" LogicalName="$(RootNamespace).Unity.Auga.dll" />
    <EmbeddedResource Include="..\UiLibShim\bin\$(Configuration)\ui_lib.dll" Link="ui_lib.dll" LogicalName="$(RootNamespace).ui_lib.dll" />
    <EmbeddedResource Include="..\Libs\fastJSON.dll" Link="fastJSON.dll" LogicalName="$(RootNamespace).fastJSON.dll" />
    <EmbeddedResource Include="$(AugaRefs)\APIManager\APIManager.dll" Link="APIManager.dll" LogicalName="$(RootNamespace).APIManager.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <!-- ILRepack (merges APIManager.dll into Auga.dll); the package is checked in under ..\packages.
       ILRepackTargetsFile must be set explicitly: $(ProjectDir) is not defined yet at this point of an SDK-style project. -->
  <PropertyGroup>
    <ILRepackTargetsFile>$(MSBuildProjectDirectory)\ILRepack.targets</ILRepackTargetsFile>
  </PropertyGroup>
  <Import Project="..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets" Condition="Exists('..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets')" />
  <Target Name="EnsureILRepackPackage" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets')" Text="Missing ..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2 (it is part of the repository)." />
  </Target>

  <!-- Copy the built plugin into the BepInEx plugins folder (see DeployToValheim / BepInExDir in ..\Directory.Build.props). -->
  <Target Name="DeployToValheim" AfterTargets="ILRepacker" Condition="'$(DeployToValheim)' == 'true' And '$(IsApiBuild)' != 'true'">
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)translations.json" DestinationFolder="$(BepInExPlugins)\$(ProjectName)\" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BepInExPlugins)\$(ProjectName)\" />
    <Copy Condition="'$(BepInExExtraPlugins)' != ''" SourceFiles="$(TargetPath);$(ProjectDir)translations.json" DestinationFolder="$(BepInExExtraPlugins)\$(ProjectName)\" />
    <Message Condition="'$(BepInExExtraPlugins)' != ''" Importance="high" Text="Deployed $(TargetFileName) to $(BepInExExtraPlugins)\$(ProjectName)\" />
  </Target>
  <!-- API builds are always published to References\AugaAPI for AugaApiExample. -->
  <Target Name="PublishApiReference" AfterTargets="ILRepacker" Condition="'$(IsApiBuild)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AugaRefs)\AugaAPI\" />
  </Target>

</Project>
