<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пути к Valheim и BepInEx -->
  <Import Project="..\Valheim.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Auga</AssemblyName>
    <RootNamespace>Auga</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10</LangVersion>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <!-- Отключаем авто-генерацию AssemblyInfo — Properties\AssemblyInfo.cs уже есть -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{BCC7DD31-D943-4684-800E-176A97DDDB8F}</ProjectGuid>
  </PropertyGroup>

  <!-- API-конфигурация: только публичный API-слой -->
  <PropertyGroup Condition="'$(Configuration)' == 'API'">
    <AssemblyName>AugaAPI</AssemblyName>
    <DefineConstants>API;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- NuGet пакеты -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" />
    <!-- ILRepack.Lib.MSBuild.Task несовместим с .NET 10 SDK и избыточен:
         APIManager.dll уже встроен как EmbeddedResource и грузится через AppDomain.AssemblyResolve -->
  </ItemGroup>

  <!-- Ссылки на BepInEx -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- APIManager — stub или настоящая DLL в Libs\ -->
    <Reference Include="APIManager">
      <HintPath>..\Libs\APIManager.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Valheim assemblies — публикуются через BepInEx.AssemblyPublicizer.MSBuild -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManagedDir)\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ValheimManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ValheimManagedDir)\gui_framework.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- fastJSON -->
    <Reference Include="fastJSON">
      <HintPath>..\Libs\fastJSON.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Исключаем файлы с проблемами компиляции или не входящие в сборку -->
  <ItemGroup>
    <Compile Remove="API.External.cs" />
  </ItemGroup>

  <!-- В API-конфигурации исключаем все файлы, не относящиеся к публичному API -->
  <ItemGroup Condition="'$(Configuration)' == 'API'">
    <Compile Remove="Auga.cs" />
    <Compile Remove="MovableHudElement.cs" />
    <Compile Remove="AugaLog_Hooks.cs" />
    <Compile Remove="Chat_Setup.cs" />
    <Compile Remove="Connection_Setup.cs" />
    <Compile Remove="DamageText_Setup.cs" />
    <Compile Remove="Extensions.cs" />
    <Compile Remove="GuiBar_Patch.cs" />
    <Compile Remove="Hud_Setup.cs" />
    <Compile Remove="LastHitTracker.cs" />
    <Compile Remove="MainMenu_Setup.cs" />
    <Compile Remove="MessageHud_Setup.cs" />
    <Compile Remove="PauseMenu_Setup.cs" />
    <Compile Remove="PlayerInventory_Setup.cs" />
    <Compile Remove="Settings_Setup.cs" />
    <Compile Remove="SetupHelper.cs" />
    <Compile Remove="Store_Setup.cs" />
    <Compile Remove="TextInput_Setup.cs" />
    <Compile Remove="EnemeyHud_Setup.cs" />
    <Compile Remove="TextViewer_Setup.cs" />
    <Compile Remove="Text_Patch.cs" />
    <Compile Remove="UITooltip_Patch.cs" />
    <Compile Remove="Minimap_Setup.cs" />
    <Compile Remove="Barber_Setup.cs" />
    <Compile Remove="Compat\Chatter.cs" />
    <Compile Remove="Compat\Jewelcrafting.cs" />
    <Compile Remove="Compat\SearsCatalog.cs" />
    <Compile Remove="SkillsDialog_Patch.cs" />
    <Compile Remove="Utilities\TranspilerHelpers.cs" />
  </ItemGroup>

  <!-- Встроенные ресурсы (только для не-API сборки) -->
  <ItemGroup Condition="'$(Configuration)' != 'API'">
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets">
      <Link>augaassets</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\AugaUnityLib\bin\$(Configuration)\net472\Unity.Auga.dll">
      <Link>Unity.Auga.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Libs\fastJSON.dll">
      <Link>fastJSON.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Libs\APIManager.dll">
      <Link>APIManager.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ProjectReference к AugaUnityLib (только для не-API) -->
  <ItemGroup Condition="'$(Configuration)' != 'API'">
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj" />
  </ItemGroup>

  <!--
    ILRepack.Lib.MSBuild.Task (PackageReference выше) автоматически импортирует ILRepack.targets
    из директории проекта — явный <Import> не нужен и вызывает MSB4011.
    Переименуем наш файл в ILRepack.targets чтобы пакет его подхватил автоматически.
  -->

  <!-- Копирование мода в папку плагинов Valheim -->
  <Target Name="CopyToValheim" AfterTargets="Build" Condition="'$(Configuration)' != 'API'">
    <Exec Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(ValheimPluginsDir)\$(ProjectName)\&quot; /q /y /i"
          Condition="'$(ValheimPluginsDir)' != ''" />
    <Exec Command="xcopy &quot;$(ProjectDir)translations.json&quot; &quot;$(ValheimPluginsDir)\$(ProjectName)\&quot; /q /y /i"
          Condition="'$(ValheimPluginsDir)' != '' And Exists('$(ProjectDir)translations.json')" />
  </Target>

  <!-- Для API-сборки: копируем в Libs\AugaAPI\ -->
  <Target Name="CopyAPIToLibs" AfterTargets="Build" Condition="'$(Configuration)' == 'API'">
    <Exec Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(SolutionDir)Libs\AugaAPI\&quot; /q /y /i" />
  </Target>

</Project>
